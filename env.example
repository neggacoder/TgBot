# Токен бота от @BotFather
BOT_TOKEN=

# ID владельцев через запятую (их нельзя снять с админки через панель бота)
OWNER_IDS=123456789,987654321

# Подключение к MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=neongelion
DB_PASSWORD=
DB_NAME=neongelion

# Сколько предупреждений (варнов) допускается, прежде чем бот автоматически
# забанит пользователя и сбросит его счётчик варнов (как у Iris). По умолчанию 3.
WARN_LIMIT=3

# --- Расшифровка медиа в чате уведомлений ----------------------------------
# Модель faster-whisper скачивается при первой расшифровке. small — баланс
# качества и скорости на CPU; tiny/base быстрее, medium/large точнее, но
# заметно требовательнее к памяти.
FASTER_WHISPER_MODEL=small
# Для обычного сервера оставьте cpu + int8. Для CUDA можно указать cuda + float16.
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- Веб-панель (python -m webpanel) ---------------------------------------
# Ключ подписи сессий. ОБЯЗАТЕЛЬНО задайте свой, иначе он будет генерироваться
# заново при каждом запуске и всех будет выкидывать из панели после рестарта.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SESSION_SECRET=

# Панель слушает только localhost — наружу её отдаёт Tailscale Funnel.
# Менять host на 0.0.0.0 не нужно: так порт откроется в сеть по голому http.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080

# Адрес, по которому панель видна ИЗ ИНТЕРНЕТА. Используется в двух местах:
# ссылка «Сайт» в личке бота и — важнее — ссылки на картинки-реакции к
# РП-жестам. Превью под сообщением рисует сам Telegram: его серверы идут по
# этой ссылке, поэтому адрес должен быть доступен снаружи, а не localhost.
# Оставьте пустым — возьмётся адрес по умолчанию из rp_photos.py.
PANEL_PUBLIC_URL=

# Кому верить в заголовке X-Forwarded-For (по нему считаются неудачные входы).
# По умолчанию — только loopback, откуда и приходит Funnel. Менять нужно,
# только если панель поставили за другой обратный прокси: указать его сеть.
# Открывать это на 0.0.0.0/0 нельзя — тогда порог перебора обходится подделкой
# заголовка.
PANEL_TRUSTED_PROXIES=127.0.0.0/8,::1/128
