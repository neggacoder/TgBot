# Токен бота от @BotFather
BOT_TOKEN=

# ID владельцев через запятую (их нельзя снять с админки через панель бота)
OWNER_IDS=123456789,987654321

# Подключение к MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=neongelion
DB_PASSWORD=
DB_NAME=neongelion

# Сколько предупреждений (варнов) допускается, прежде чем бот автоматически
# забанит пользователя и сбросит его счётчик варнов (как у Iris). По умолчанию 3.
WARN_LIMIT=3

# --- Веб-панель (python -m webpanel) ---------------------------------------
# Ключ подписи сессий. ОБЯЗАТЕЛЬНО задайте свой, иначе он будет генерироваться
# заново при каждом запуске и всех будет выкидывать из панели после рестарта.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
PANEL_SESSION_SECRET=

# Панель слушает только localhost — наружу её отдаёт Tailscale Funnel.
# Менять host на 0.0.0.0 не нужно: так порт откроется в сеть по голому http.
PANEL_HOST=127.0.0.1
PANEL_PORT=8080
